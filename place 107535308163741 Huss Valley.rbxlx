function u1.purchase(u129, u130) -- Line: 626
    -- upvalues: BundlePanel (copy), ShopConfig (copy), OfferRules (copy), MarketplaceService (copy)
    if not (u129.open and (u130.button.Active and u129:eligible(u130))) then
        return;
    end;

    if u129.player:GetAttribute("InMatch") == true or not u129.state.loaded then
        return;
    end;

    if u130.kind == "Reward" then
        if u129:owned(u130) then
            script.Parent.ArmoryEvent:FireServer("Equip", u130.key);

            return;
        end;

        if u130.key == "BalloonDagger" then
            script.Parent.ArmoryNavigation:Fire("Balloon");
        end;

        return;
    end;

    if u130.kind == "Gem" then
        if not (u129:owned(u130) or u129.catalog.canBuy(u130.key, workspace:GetServerTimeNow())) then
            u129:refresh();
            u129:notice("This offer has ended or is not available yet.");

            return;
        end;

        if not u129:owned(u130) and u129.state.gems < u129.catalog.get(u130.key).Offer.Price then
            u129:notice("Collect more gems during crossings to claim this knife.");

            return;
        end;

        script.Parent.ArmoryEvent:FireServer(u129:owned(u130) and "Equip" or "Buy", u130.key);
        u129:notice(u129:owned(u130) and "Equipping your knife…" or "Adding this knife to your collection…");

        return;
    end;

    if u130.kind == "Bundle" then
        BundlePanel.open(u129:owned(u130));

        return;
    end;

    if u129.binding.PurchasesEnabled == false then
        u129:notice("Robux purchases are available in the live game.");

        return;
    end;

    if u129:owned(u130) then
        return;
    end;

    if u130.kind ~= "Pass" or u130.key ~= ShopConfig.Flagship.OfferKey and u130.key ~= ShopConfig.GhostFlagship.OfferKey or OfferRules.active(u130.key == ShopConfig.Flagship.OfferKey and ShopConfig.Flagship or ShopConfig.GhostFlagship, workspace:GetServerTimeNow()) then
        if not pcall(function() -- Line: 678
            -- upvalues: u130 (copy), MarketplaceService (ref), u129 (copy)
            if u130.kind == "Pass" then
                MarketplaceService:PromptGamePassPurchase(u129.player, u130.id);

                return;
            end;

            MarketplaceService:PromptProductPurchase(u129.player, u130.id);
        end) then
            u129:notice("The purchase window could not open. Please try again.");
        end;

        return;
    end;

    u129:refresh();
end;

