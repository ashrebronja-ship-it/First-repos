function u1.step(p177, p178) -- Line: 894
    -- upvalues: UserInputService (copy)
    if not p177.open then
        return;
    end;

    if p177.gear then
        p177.gear:step(p178);
    end;

    p177.items:step(p178);

    if p177.section == "Emotes" then
        p177.emotes:step(p178);
    elseif p177.section == "Shop" then
        p177.daily:step(p178);
    end;

    local v179 = p177.section == "Abilities" and p177.abilityRoot or p177.section == "Items" and p177.itemRoot or (p177.section == "Emotes" and p177.emotes.list or p177.root);
    local v180;

    if v179.AbsoluteCanvasSize.Y - v179.AbsoluteWindowSize.Y - v179.CanvasPosition.Y > 12 then
        v180 = p177.canvas.Notice.Text == "";
    else
        v180 = false;
    end;

    p177.canvas.ScrollHint.Visible = v180;
    p177.canvas.ScrollHint.Text = UserInputService.TouchEnabled and "SWIPE UP · MORE IN STORE  ↓" or "SCROLL FOR MORE  ↓";
    p177.timerElapsed = (p177.timerElapsed or 0) + p178;

    if p177.timerElapsed >= 0.2 then
        p177.timerElapsed = 0;
        p177:refresh();
    end;

    for _, v in p177.previews do
        if not v.dragging then
            v.rotation = v.rotation + math.min(p178, 0.1) * 0.15;
        end;

        local v181 = v.extent * 2;
        local camera = v.camera;
        local CFrame_lookAt = CFrame.lookAt;
        local v182 = math.sin(v.rotation) * v181;
        local v183 = 0.1 * v.extent;
        local v184 = math.cos(v.rotation) * v181;
        camera.CFrame = CFrame_lookAt(Vector3.new(v182, v183, v184), Vector3.new(0, 0, 0));
    end;

    if p177.noticeUntil and os.clock() > p177.noticeUntil then
        p177.canvas.Notice.Text = "";
        p177.noticeUntil = nil;
    end;
end;

